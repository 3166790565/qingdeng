# 复制成 .env 就生效（.env 已在 .gitignore 里）。
# 优先级：系统环境变量 > 本文件 > 内置默认值。
# 支持整行 # 注释、可选的 export 前缀、成对的引号；不支持行尾注释。

# 后台密码。留空或删掉这一行，每次启动会随机生成一个并打印到日志
ADMIN_PASSWORD=换成你自己的密码

# 会话 cookie 签名密钥。不固定的话每次重启都会把已登录的会话踢下线
# 生成一串：go run ./cmd/genkey
SECRET_KEY=换成一串足够长的随机字符

# 写进书源和 API 返回 URL 的对外地址。手机要访问电脑就填局域网 IP
SITE_BASE_URL=http://127.0.0.1:8000

# 站名与副标题
# SITE_NAME=青灯书斋
# SITE_TAGLINE=一盏灯，一本书

# 给 /api/* 加令牌。留空则公开（书源抓取通常需要免鉴权）
# API_TOKEN=

# Telegram 频道爬取的应用凭证，在 https://my.telegram.org → API development tools 申请。
# 只填这两项还不够：启动后到后台「TG 频道」页输手机号收验证码完成账号登录
# TG_API_ID=123456
# TG_API_HASH=0123456789abcdef0123456789abcdef

# TG 出站代理。国内服务器连不上 Telegram 时必须配，留空直连。
# 支持 socks5:// 与 http://；带认证写 socks5://user:pass@host:port
# 也可以启动后在后台「TG 频道」页填写，那边的设置优先于这里。
#
# 注意 Docker：容器里的 127.0.0.1 是容器自己。
#   代理在宿主机 → 写 host.docker.internal:7890（compose 已加 extra_hosts）
#   代理在别的容器 → 写容器名:7890
#   用 docker-compose.prod-host.yml（host 网络）→ 才能写 127.0.0.1:7890
# TG_PROXY_URL=socks5://host.docker.internal:7890
# TG_PROXY_TIMEOUT=30

# 数据目录与库文件位置（Docker 下这两项由 docker-compose.yml 接管，写在这里没用）
# NOVEL_DATA_DIR=data
# NOVEL_DB_PATH=data/novel.db

# 监听设置（Docker 下不生效，容器里固定 0.0.0.0:8000）
# HOST=127.0.0.1
# PORT=8000

# ---------------------------------------------------------------- 只有 Docker 用得到
# 注意：compose 解析本文件时不认 `export ` 前缀，值也别加引号。
# DB_FILE=novel.db
# HOST_PORT=8000
# BIND_ADDR=127.0.0.1
